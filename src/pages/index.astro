---
import { getCollection } from 'astro:content';
import FaqSearch, { type FaqItem } from '../components/FaqSearch';
import Layout from '../layouts/Layout.astro';

const categories = ['アカウント', '講座', '学習履歴', '料金・支払い', '動画再生'];
const entries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const faqs: FaqItem[] = entries.map((entry) => ({
	id: entry.id,
	title: entry.data.title,
	category: entry.data.category,
	keywords: entry.data.keywords,
	summary: entry.data.summary,
	href: `/faq/${entry.id}`,
}));
---

<Layout title="FAQ | 学習サービス ヘルプ">
	<main class="page-shell">
		<header class="page-header">
			<h1>よくある質問</h1>
			<p>アカウント、講座、学習履歴、料金、動画再生についてご案内します。</p>
		</header>

		<section aria-labelledby="faq-heading">
			<h2 id="faq-heading" class="section-heading">質問を探す</h2>
			<FaqSearch faqs={faqs} categories={categories} client:load />
		</section>
	</main>
</Layout>
